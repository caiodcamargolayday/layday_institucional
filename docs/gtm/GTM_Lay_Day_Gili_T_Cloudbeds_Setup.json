        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n  function parseVal(v) {\n    if (v === null || v === undefined) return 0;\n    var s = String(v).replace(/[^0-9.,]/g, '');\n    if (!s) return 0;\n    var dots = (s.match(/\\./g) || []).length;\n    var commas = (s.match(/,/g) || []).length;\n    if (dots > 1 && commas === 0) s = s.replace(/\\./g, '');\n    else if (commas > 1 && dots === 0) s = s.replace(/,/g, '');\n    else if (dots >= 1 && commas >= 1) {\n      s = s.lastIndexOf('.') > s.lastIndexOf(',') ? s.replace(/,/g, '') : s.replace(/\\./g, '').replace(',', '.');\n    } else if (commas === 1) {\n      var afterComma = s.split(',')[1] || '';\n      s = afterComma.length === 3 ? s.replace(',', '') : s.replace(',', '.');\n    }\n    var n = Number(s);\n    return isNaN(n) ? 0 : n;\n  }\n\n  try {\n    var val = {{dlv - ecommerce.value}};\n    if (val && !isNaN(val) && Number(val) > 0) return Number(val);\n  } catch(e) {}\n\n  try {\n    var dl = window.dataLayer || [];\n    for (var i = dl.length - 1; i >= 0; i--) {\n      var row = dl[i];\n      if (!row) continue;\n      if (row.ecommerce && row.ecommerce.purchase && row.ecommerce.purchase.actionField && row.ecommerce.purchase.actionField.revenue) {\n        var f = parseVal(row.ecommerce.purchase.actionField.revenue);\n        if (f > 0) return f;\n      }\n      if (row.ecommerce && row.ecommerce.value) {\n        var g = parseVal(row.ecommerce.value);\n        if (g > 0) return g;\n      }\n      var direct = row.grand_total || row.total || row.reservation_total || row.booking_total || (row.cloudbeds && (row.cloudbeds.total || row.cloudbeds.grand_total));\n      if (direct) {\n        var h = parseVal(direct);\n        if (h > 0) return h;\n      }\n    }\n  } catch(e) {}\n\n  return 0;\n}"
          }
        ]
